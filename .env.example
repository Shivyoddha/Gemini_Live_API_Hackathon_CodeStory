# CodeStory — single .env at project root
# Copy to .env and fill in values. All components (frontend, backend, pipeline) use this file.
# 

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# API base URL (content, pipeline, search endpoints)
# Local: http://localhost:8081 | Prod: https://your-service.run.app (no trailing slash)
VITE_API_BASE=http://localhost:8081

# WebSocket URL for Gemini Live API proxy (optional)
# If unset, derived from VITE_API_BASE (e.g. https://x.run.app → wss://x.run.app/ws)
# VITE_PROXY_WS_URL=ws://localhost:8080

# Google Cloud project ID for Vertex AI / Gemini Live API (required for Connect)
VITE_PROJECT_ID=

# Gemini Live API model ID (optional; use gemini-live-2.5-flash-native-audio for Vertex AI)
# VITE_MODEL_ID=gemini-live-2.5-flash-native-audio

# Skip GitHub URL step and open dashboard directly (dev only)
# VITE_DEV_SKIP_PIPELINE=true

# ── Backend (server.py) ─────────────────────────────────────────────────────
# Cloud Run sets PORT; nginx uses it. Local dev uses defaults.
# PORT=8080
# HTTP_PORT=8081
# WS_PORT=8080

# GCS bucket for session docs/slides (empty = local disk only)
GCS_BUCKET=

# GCP project (optional; ADC can infer from credentials)
GOOGLE_CLOUD_PROJECT=

# ── Pipeline (main.py) ─────────────────────────────────────────────────────
# API key for Gemini/ADK agents (required for pipeline)
# Use either variable name:
GEMINI_API_KEY=
# GOOGLE_API_KEY=
